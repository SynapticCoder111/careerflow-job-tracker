# Copy to `.env` and fill in the values. Never commit the real `.env`.

# Required ---------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/careerflow
PORT=3000

# Optional ---------------------------------------------------------------
# Comma-separated browser origins allowed to call the API from another origin.
# Leave unset when the frontend is served by this same process (the normal
# case). In production, leaving it unset disables cross-origin access entirely
# rather than reflecting whatever origin asks.
# ALLOWED_ORIGIN=https://app.example.com

# One-time migration flag. When true, the first account to register adopts
# records created before accounts existed (rows with no userId). Leave unset
# in normal operation; remove the migration after it has run once.
# ALLOW_LEGACY_ADOPTION=false

# Set to true only when a reverse proxy (nginx, a PaaS router) sets
# X-Forwarded-For. Otherwise clients could spoof their address and evade the
# rate limiter.
# TRUST_PROXY=false

# MongoDB server-selection timeout in milliseconds (default 10000). The server
# refuses to listen until this connection succeeds.
# MONGO_TIMEOUT_MS=10000

# Set to "production" to enable fail-closed CORS behaviour.
# NODE_ENV=production
